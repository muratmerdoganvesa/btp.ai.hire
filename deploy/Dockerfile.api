FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props HireLens.sln ./
COPY src ./src
COPY tests ./tests
COPY prompts ./prompts
RUN dotnet restore HireLens.sln
RUN dotnet publish src/HireLens.Api/HireLens.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ARG GIT_SHA=unknown
WORKDIR /app
RUN useradd --create-home --uid 10001 hirelens
COPY --from=build /app .
COPY --from=build /src/prompts ./prompts
RUN mkdir -p /app/App_Data/object-store && chown -R hirelens:hirelens /app/App_Data
USER 10001
ENV ASPNETCORE_URLS=
ENV ASPNETCORE_ENVIRONMENT=Production
ENV GIT_SHA=$GIT_SHA
EXPOSE 8080
ENTRYPOINT ["dotnet", "HireLens.Api.dll"]
