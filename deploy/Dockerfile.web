FROM node:22-alpine AS build
WORKDIR /web
RUN corepack enable
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
COPY frontend/packages ./packages
COPY frontend/apps ./apps
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @hirelens/design-tokens build \
    && pnpm --filter @hirelens/domain build \
    && pnpm --filter @hirelens/i18n build \
    && pnpm --filter @hirelens/api-client build \
    && pnpm --filter @hirelens/ui build \
    && pnpm --filter @hirelens/recruiter-console build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /web/apps/recruiter-console/dist /usr/share/nginx/html
ENV PORT=8080
ENV API_UPSTREAM=http://127.0.0.1:8080
ENV NGINX_ENVSUBST_FILTER=PORT|API_UPSTREAM
EXPOSE 8080
